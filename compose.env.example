# Copy to compose.env, fill every required value, and pass it with:
# docker compose --env-file compose.env up --build
# Required: Compose refuses to start when any of these values is empty.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=

# The default Compose profile uses the offline AI mock.
AI_MOCK_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# Leave false for http://127.0.0.1:3000. Set true only when the browser uses HTTPS.
# The frontend proxy also adds Secure when it receives an https:// request.
REFRESH_COOKIE_SECURE=false

# Metrics: a random token of at least 32 characters that the Prometheus scraper sends as
# "Authorization: Bearer ..." to /actuator/prometheus. Empty exposes no metrics.
METRICS_TOKEN=

# CSRF: full origins (scheme://host[:port]) allowed when a browser sends Origin but no
# Sec-Fetch-Site. Passed to both backend and frontend. Leave unset (or empty) locally to
# use http://localhost:3000,http://127.0.0.1:3000. When deploying behind a reverse proxy,
# set it to the public origin the browser sees, e.g.:
# TRUSTED_ORIGINS=https://resume.example.com

# Comma-separated literal IPs. Frontend: the reverse proxy hop(s) that append XFF.
# Backend: the frontend container's address on the backend network; pin it when deploying.
# Empty trusts no forwarded identity.
TRUSTED_PROXIES=
BACKEND_TRUSTED_PROXIES=
