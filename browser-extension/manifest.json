{
  "manifest_version": 3,
  "name": "ResumeLens 岗位助手",
  "version": "0.3.0",
  "description": "从 BOSS 直聘抓取当前 JD，在 ResumeLens 中查重、保存并完成简历匹配；授权后可由 AI 助手在 BOSS 搜索页只读采集岗位列表。",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": ["https://*.zhipin.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "ResumeLens 岗位助手",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["src/command-relay.js", "src/content-resumelens.js"],
      "run_at": "document_idle"
    }
  ]
}
